# Non-production SkyShare demo configuration. Copy values into the deployment
# secret store; never commit populated credentials.
NEXT_PUBLIC_SUPABASE_URL=https://DEMO_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-demo-publishable-key
SUPABASE_SECRET_KEY=replace-with-demo-secret-key
CRON_SECRET=replace-with-random-demo-cron-secret
SKYSHARE_DISCOVERY_ORGANIZATION_ID=replace-with-skyshare-demo-organization-id
SKYSHARE_DISCOVERY_HUNT1_ENABLED=true
SKYSHARE_DISCOVERY_HUNT2_ENABLED=true
SKYSHARE_DISCOVERY_HUNT3_PUBLIC_WEB_ENABLED=true
SKYSHARE_DISCOVERY_HUNT4_ENABLED=true
