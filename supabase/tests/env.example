# RLS test suite environment — STAGING/DEV ONLY.
# Copy to `.env.test.local` at the repo root (that path is git-ignored by `.env*`)
# and fill in values from a development/staging Supabase project. NEVER point this
# at production: seed/teardown delete users and cascade-drop organizations.
#
# Load it with Node's native flag, e.g.:
#   node --env-file=.env.test.local --test supabase/tests/rls.test.mjs

# Supabase project URL (Dashboard > Project Settings > API).
SUPABASE_URL=

# Publishable / anon key (safe to expose to browsers).
SUPABASE_ANON_KEY=

# Service-role key (SECRET). Used only to seed and tear down fixtures.
# Keep it out of version control; `.env.test.local` is git-ignored.
SUPABASE_SERVICE_ROLE_KEY=

# Explicit opt-in required before any destructive seed/teardown runs.
RLS_TEST_ALLOW_DESTRUCTIVE=true

# Optional. When true, a missing/incomplete config is a hard test FAILURE instead of a
# skip, so an expired or unset key can never be mistaken for a passing run. Leave unset
# locally; CI sets it in the protected staging job.
# RLS_REQUIRE_CONFIG=true
